# 邮件（找回密码验证码）SMTP 配置模板：cp conf/mail.env.example conf/mail.env 后填真实值。
# conf/mail.env 已 gitignore（含 SMTP 授权码，等同密码），服务器上建议 chmod 600。
# 全部留空 = 不启用邮件：/api/user/password-reset/* 返回 503，其他功能不受影响。
POMELO_MAIL_HOST=smtp.example.com
# 465=直连 TLS（POMELO_MAIL_SSL=true）；587=STARTTLS（SSL=false 且 STARTTLS=true）
POMELO_MAIL_PORT=465
POMELO_MAIL_USERNAME=your-account@example.com
# 多数邮箱服务要求用「授权码」而非登录密码
POMELO_MAIL_PASSWORD=your-smtp-token
POMELO_MAIL_FROM=your-account@example.com
POMELO_MAIL_SSL=true
POMELO_MAIL_STARTTLS=false
