# Git
.git
.gitignore
.gitattributes

# IDE
.idea/
*.iml
.vscode/
.eclipse/
.settings/

# Maven build output (except fat jars — 兼容根 Dockerfile 与 seqsvr Dockerfile 的 host-build + COPY)
**/target/*
!target/pomelo-*-fat.jar
!pomelo-seqsvr/*/target/*-fat.jar

# Node.js (SDK build artifacts)
node_modules/
src/test/resources/node_modules/
package-lock.json

# Docs
docs/

# OS
.DS_Store
Thumbs.db

# Docker
.dockerignore
docker-compose*.yml
Dockerfile*

# Claude
.claude/

# Temp
*.log
*.tmp
*.swp
*.swo

# 注意：不能排除 src/main/proto/ —— Docker 内执行 mvn 构建时 protobuf-maven-plugin 需要 .proto 源码重新生成
