# 演示部署域名与凭据配置模板：cp .env.demo.example .env 后按需修改
# compose 自动读取仓库根 .env（已 gitignore，不要提交）；域名需 A 记录指向服务器公网 IP
DEMO_DOMAIN=pomelo.host
DEMO_MEDIA_DOMAIN=oss.pomelo.host
# Grafana 登录凭据（https://grafana.<DEMO_DOMAIN> 入口，公网形态已关闭匿名只读；
# 密码必填，缺失时 compose 拒绝启动）。注意密码只在 grafana-data 卷首启时生效，
# 已初始化过的旧部署需在 UI 改密或删卷重建（看板由 provisioning 只读挂载，不丢）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please
# 端口发布范围（见 docker-compose.yml gateway/pomelo 的 ports 注释）：
#   TCP 网关公网直连给原生客户端（tcps://host:9000，Caddy 无法代理原始 TCP）
POMELO_TCP_BIND=0.0.0.0
#   API 与 WS 仅经 Caddy 反代访问，宿主端口不对公网开放
POMELO_API_BIND=127.0.0.1
POMELO_WS_BIND=127.0.0.1
# 服务器上必须保留本行：让所有 docker compose 命令自动合并 demo overlay
# （POMELO_MEDIA_PUBLIC_ENDPOINT 等环境变量依赖它注入；缺失会导致 presigned
#  URL 回落 http://localhost:9002，线上图片/头像/上传全部失效）
COMPOSE_FILE=docker-compose.yml:docker-compose.demo.yml
