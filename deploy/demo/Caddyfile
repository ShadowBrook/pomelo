# Pomelo 演示/生产反代（Caddy 2）—— 双域名形态（主站 + 对象存储）+ TCP 网关 layer4 接入
# 用法见 docs/2026-09-14-demo-deploy.md；域名经 docker-compose.demo.yml 注入环境变量：
#   SITE_DOMAIN  = pomelo.host         （前端 + /api + /ws + /lk + TCP 9000）
#   MEDIA_DOMAIN = oss.pomelo.host     （对象存储 presigned URL 直连 MinIO）
#
# 证书：域名形态由 Caddy 向 Let's Encrypt 自动签发续期（需 80/443 公网可达，国内服务器
# 域名需已完成备案）。import.d 目录保持为空。
# 纯 IP 备选形态：见 import.d/tls-local.caddy.example。
#
# 镜像：需含 layer4 模块的自定义构建（官方 caddy:2 无 l4，起不来），见
# deploy/demo/caddy-l4/Dockerfile，docker compose build caddy 生成 pomelo/caddy-l4:2。

# =====================================================================
# 全局选项：layer4 应用 —— 原生客户端 TCP 接入（tcps://host:9000）
# 终结 TLS 后明文转发容器内网 gateway:9000。tls handler 不自签证书，
# 但复用下方 {$SITE_DOMAIN} HTTP 站点 ACME 签发的证书（同一实例共享证书缓存），
# 原生客户端因此拿到正规 Let's Encrypt 证书，无需信任自签。
# 网关侧须为明文：docker-compose.demo.yml 将 gateway 的 POMELO_TLS_ENABLED 置 false
# （WS 9001 同理经本文件 /ws 明文反代，TLS 统一在边缘终结）。
# =====================================================================
{
	layer4 {
		:9000 {
			# 仅放行 SNI=主域 的握手；无 SNI / 其它 SNI 一律断开（挡扫描器直连）
			@sni {
				tls sni {$SITE_DOMAIN}
			}
			route @sni {
				tls
				proxy pomelo-gateway:9000
			}
		}
	}
}

{$SITE_DOMAIN} {
	import /etc/caddy/import.d/*.caddy
	encode gzip zstd

	# 业务 API（上游 8888 是自签 TLS，跳过校验）
	handle /api/* {
		reverse_proxy https://pomelo:8888 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	# 网关 WebSocket（同源 /ws，与前端 useIMClient 的地址派生一致）。
	# TLS 在边缘统一终结：demo 形态网关本体为明文（POMELO_TLS_ENABLED=false），
	# 故此处直连明文上游，不再 https + skip_verify。
	handle /ws {
		reverse_proxy pomelo-gateway:9001
	}

	# LiveKit 信令：剥掉 /lk 前缀（与 Vite 开发代理一致，LiveKit 只识别根路径）
	handle /lk/* {
		uri strip_prefix /lk
		reverse_proxy livekit:7880
	}

	# @ 提及/混合内容兜底：客户端会把 http 形态的 presigned URL 改写到主域 /minio。
	# 剥前缀转发 MinIO，并把 Host 改回签发时的 publicEndpoint（基线默认 localhost:9002），
	# SigV4 校验才能通过；若修改了 POMELO_MEDIA_PUBLIC_ENDPOINT，此处 Host 需同步。
	# 服务器必须正确注入 POMELO_MEDIA_PUBLIC_ENDPOINT=https://{$MEDIA_DOMAIN}（见 §6），
	# 该路由仅为误配置兜底。
	handle /minio/* {
		reverse_proxy silo:9000 {
			header_up Host localhost:9002
		}
	}

	# 前端静态资源（SPA 回退到 index.html）
	handle {
		root * /srv/dist
		try_files {path} {path}/ /index.html
		file_server
	}
}

# 对象存储子域：presigned URL 直连 MinIO S3。
# SigV4 签名包含 Host，Caddy 原样透传，MinIO 校验通过；conf 侧用
# POMELO_MEDIA_PUBLIC_ENDPOINT=https://{$MEDIA_DOMAIN} 注入（docker-compose.demo.yml）。
{$MEDIA_DOMAIN} {
	reverse_proxy silo:9000
}

# 监控子域：Grafana（需 grafana.{$SITE_DOMAIN} 的 A 记录指向服务器公网 IP）。
# 认证由 Grafana 自身负责：demo overlay 已关闭匿名只读并强制登录，凭据在服务器
# .env 注入（GRAFANA_ADMIN_USER / GRAFANA_ADMIN_PASSWORD）。如需再加一层网关
# 口令（先于 Grafana 拦截扫描器），取消下面注释并 `caddy hash-password` 生成哈希：
#	basic_auth {
#		admin <JDJhJDEwJEFS...>
#	}
grafana.{$SITE_DOMAIN} {
	reverse_proxy grafana:3000
}
